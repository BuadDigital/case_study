{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "RealEstateEval",
    "Audience": "RealEstateEval"
  },
  "ReportingHttpResilience": {
    "TotalTimeoutSeconds": 15,
    "AttemptTimeoutSeconds": 4,
    "RetryCount": 2,
    "RetryDelayMilliseconds": 200,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 10,
    "CircuitBreakerSamplingSeconds": 30,
    "CircuitBreakerBreakSeconds": 15
  }
}
