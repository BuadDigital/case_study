<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RealEstateEval.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.8" />
    <!-- compile is included so the per-context design-time factories (ADR 0003) can be
         declared next to their contexts; PrivateAssets keeps it out of consuming projects. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>compile; runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RealEstateEval.Application\RealEstateEval.Application.csproj" />
    <ProjectReference Include="..\contexts\attachments\RealEstateEval.Attachments.Application\RealEstateEval.Attachments.Application.csproj" />
    <ProjectReference Include="..\contexts\failures\RealEstateEval.Failures.Application\RealEstateEval.Failures.Application.csproj" />
    <ProjectReference Include="..\contexts\financial\RealEstateEval.Financial.Application\RealEstateEval.Financial.Application.csproj" />
    <ProjectReference Include="..\contexts\operations\RealEstateEval.Operations.Application\RealEstateEval.Operations.Application.csproj" />
    <ProjectReference Include="..\contexts\platform\RealEstateEval.Platform.Application\RealEstateEval.Platform.Application.csproj" />
    <ProjectReference Include="..\contexts\valuation\RealEstateEval.Valuation.Application\RealEstateEval.Valuation.Application.csproj" />
    <ProjectReference Include="..\RealEstateEval.Domain\RealEstateEval.Domain.csproj" />
    <ProjectReference Include="..\shared\RealEstateEval.Shared.Contracts\RealEstateEval.Shared.Contracts.csproj" />
  </ItemGroup>

</Project>
