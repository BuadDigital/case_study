<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RealEstateEval.Platform.Infrastructure</RootNamespace>
  </PropertyGroup>

    <ItemGroup>
    <ProjectReference Include="..\RealEstateEval.Platform.Application\RealEstateEval.Platform.Application.csproj" />
    <ProjectReference Include="..\..\..\RealEstateEval.Infrastructure\RealEstateEval.Infrastructure.csproj" />
    <ProjectReference Include="..\..\valuation\RealEstateEval.Valuation.Domain\RealEstateEval.Valuation.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web-push delivery lives with the Platform notification stack. -->
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The geography seed ships with LocationCatalogSeedSource: its embedded-resource
         fallback reads from typeof(LocationCatalogSeedSource).Assembly, so the json must
         live in this assembly. -->
    <None Include="Data\Seed\regions_cities.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Data\Seed\regions_cities.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: lets dotnet ef regenerate this stream's snapshot in place. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
