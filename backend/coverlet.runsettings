<?xml version="1.0" encoding="utf-8" ?>
<!--
  Coverage settings shared by every backend test project.

  EF migrations are generated files that dwarf hand-written code (over 100k lines), so leaving
  them in makes the percentage meaningless. The threshold is a regression floor, deliberately set
  below the current numbers rather than as a target: it fails a run that deletes or disables a
  meaningful share of the suite, and is raised as coverage grows.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByFile>**/Data/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
          <!-- Lowest per-project line rate today is ~17%; container tests must be enabled. -->
          <Threshold>12</Threshold>
          <ThresholdType>line</ThresholdType>
          <ThresholdStat>total</ThresholdStat>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
