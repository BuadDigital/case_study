# Copy this file to infra/.env on the production host and replace every empty value.
# Never commit the resulting .env file.

IMAGE_OWNER=
TAG=latest

# Use independent randomly generated values for each secret.
# Production deploy now fails fast if placeholder/default values are detected.
POSTGRES_PASSWORD=
RABBITMQ_USER=ree-service
RABBITMQ_PASSWORD=

# Minimum 64 characters. Generate, for example:
# openssl rand -base64 64
JWT_SIGNING_KEY=

# Optional dual-key rotation window (validate-only). Leave empty normally.
# During rotation: set to the OLD key, put the NEW key in JWT_SIGNING_KEY,
# redeploy, wait ≥ access-token lifetime (default 15 minutes), then clear this.
# See docs/ops/jwt-signing-key-rotation.md
JWT_PREVIOUS_SIGNING_KEY=

# Grafana admin (internal network only; tunnel via SSH to reach UI).
# Do not use "admin" in production.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# TLS terminates at nginx, so the certificate and key stay on the host and are mounted
# read-only. Compose refuses to start when either path is unset.
TLS_CERTIFICATE_PATH=/etc/letsencrypt/live/example.com/fullchain.pem
TLS_PRIVATE_KEY_PATH=/etc/letsencrypt/live/example.com/privkey.pem

# Public HTTPS origin, used by the post-deploy health gate.
PUBLIC_APP_URL=https://example.com

# Report PDF links (valuation service → Gotenberg container): PdfRenderer__BaseUrl is set in
# docker-compose.prod.yml (http://gotenberg:3000). No .env entry needed. Link keys are signed
# with JWT_SIGNING_KEY (separate derivation); optional override: ReportPdfLinks__Secret.

# Google Maps (browser). Not a host compose env — bake into the frontend image at CI build:
#   GitHub Actions secret: NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# Restrict the key in Google Cloud to your PUBLIC_APP_URL (and http://*.sslip.io/* if used).

# Browser CORS — only needed when the shell origin differs from the API/gateway origin.
# Comma-separated. Leave empty when nginx serves shell + API same-origin.
# Cors__AllowedOrigins=https://example.com
# Cors__RequireAllowedOrigins=true

# Web Push (Platform API). Generate VAPID keys once, then set Enabled=true:
#   npx --yes web-push generate-vapid-keys
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:ops@example.com
