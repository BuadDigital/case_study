{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/ejadah-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Tajawal|IBM Plex Sans Arabic|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: Tajawal, IBM Plex Sans Arabic, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|className|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|primary|success|warning|danger|info|purple|orange)$/]",
        "message": "<Badge> tone must be one of 'default' | 'primary' | 'success' | 'warning' | 'danger' | 'info' | 'purple' | 'orange'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|loading|disabled|onClick|children|className|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, loading, disabled, onClick, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|outline|accent|danger|dangerOutline|ghost)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'outline' | 'accent' | 'danger' | 'dangerOutline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|lg)$/]",
        "message": "<Button> size must be one of 'default' | 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|className|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfathField'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|required|error|type|options|readOnly|value|onChange|key|ref|className|style|children)$/]",
        "message": "<InfathField> doesn't accept that prop. Declared props: id, label, required, error, type, options, readOnly, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:hasError|placeholder|value|disabled|type|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: hasError, placeholder, value, disabled, type, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|footer|onClose|wide|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, title, children, footer, onClose, wide."
      },
      {
        "selector": "JSXOpeningElement[name.name='Note'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|className|key|ref|className|style|children)$/]",
        "message": "<Note> doesn't accept that prop. Declared props: tone, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Note'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|info|warn|success|danger)$/]",
        "message": "<Note> tone must be one of 'default' | 'info' | 'warn' | 'success' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|label|value|sub|className|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: accent, label, value, sub, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:default|blue|green|warn|red|amber|gray)$/]",
        "message": "<StatCard> accent must be one of 'default' | 'blue' | 'green' | 'warn' | 'red' | 'amber' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Table'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|hoverable|renderCell|className|key|ref|className|style|children)$/]",
        "message": "<Table> doesn't accept that prop. Declared props: columns, rows, hoverable, renderCell, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tab'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|count|countTone|onClick|children|className|key|ref|className|style|children)$/]",
        "message": "<Tab> doesn't accept that prop. Declared props: active, count, countTone, onClick, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tab'] > JSXAttribute[name.name='countTone'] > Literal[value!=/^(?:gray|teal|red)$/]",
        "message": "<Tab> countTone must be one of 'gray' | 'teal' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolbarSearch'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<ToolbarSearch> doesn't accept that prop. Declared props: placeholder, value, onChange, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
